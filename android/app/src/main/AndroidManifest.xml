<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately no <uses-permission android:name="android.permission.INTERNET" />.
  The questions, the images and the code all live inside the APK, and the
  Activity serves them over a private in-app origin, so the app has nothing to
  fetch. Without the permission it provably cannot reach the network even if
  something later tried to.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
      android:label="Einbürgerungstest DIAGNOSE"
      android:icon="@mipmap/ic_launcher"
      android:allowBackup="true"
      android:supportsRtl="false"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
        android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
